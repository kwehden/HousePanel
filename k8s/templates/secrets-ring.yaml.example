# DO NOT `kubectl apply` THIS FILE.
# It contains placeholder values. Applying it overwrites the live Secret and
# destroys the real credentials — this happened on 2026-08-15. It lives in
# k8s/templates/ precisely so that `kubectl apply -f k8s/` cannot reach it.
# Create the Secret with the kubectl create secret command below instead.
# Template — do not commit real token.
# Apply with: python services/ring-integration/scripts/get_token.py
# (script stores token directly to K8s, never prints value)
# See TASK-012 in spec/tasks.md for the procedure.
apiVersion: v1
kind: Secret
metadata:
  name: housepanel-ring-secrets
  namespace: housepanel
type: Opaque
stringData:
  RING_REFRESH_TOKEN: "<REPLACE_WITH_TOKEN_FROM_RING_AUTH_FLOW>"
