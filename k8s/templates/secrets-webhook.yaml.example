# DO NOT `kubectl apply` THIS FILE.
# It contains placeholder values. Applying it overwrites the live Secret and
# destroys the real credentials — this happened on 2026-08-15. It lives in
# k8s/templates/ precisely so that `kubectl apply -f k8s/` cannot reach it.
# Create the Secret with the kubectl create secret command below instead.
# Template — do not commit real values.
# To create: kubectl create secret generic housepanel-webhook-secrets \
#   --namespace housepanel \
#   --from-literal=CAMERA_WEBHOOK_SECRET=<generated> \
#   --from-literal=WEBHOOK_SECRET_UNIFI=<generated> \
#   --from-literal=WEBHOOK_SECRET_ATH=<generated>
# Generate values with: python3 -c "import secrets; print(secrets.token_hex(32))"
apiVersion: v1
kind: Secret
metadata:
  name: housepanel-webhook-secrets
  namespace: housepanel
type: Opaque
stringData:
  CAMERA_WEBHOOK_SECRET: "<REPLACE_WITH_GENERATED_VALUE>"
  WEBHOOK_SECRET_UNIFI: "<REPLACE_WITH_GENERATED_VALUE>"
  WEBHOOK_SECRET_ATH: "<REPLACE_WITH_GENERATED_VALUE>"
