# DO NOT `kubectl apply` THIS FILE.
# It contains placeholder values. Applying it overwrites the live Secret and
# destroys the real credentials — this happened on 2026-08-15. It lives in
# k8s/templates/ precisely so that `kubectl apply -f k8s/` cannot reach it.
# Create the Secret with the kubectl create secret command below instead.
# Template — do not commit real credentials.
# To create:
# kubectl create secret generic google-adc --namespace housepanel \
#   --from-file=application_default_credentials.json=/home/kwehden/.config/gcloud/application_default_credentials.json
